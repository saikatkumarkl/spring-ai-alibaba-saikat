<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.alibaba.cloud.ai.studio.admin.mapper.DatasetMapper">

    <!--Evaluation set table fields-->
    <sql id="dataset_columns">
        id, name, description, columns_config, create_time, update_time, deleted
    </sql>

    <!--Evaluation set entity mapping-->
    <resultMap id="datasetResultMap" type="com.alibaba.cloud.ai.studio.admin.entity.DatasetDO">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="columnsConfig" column="columns_config"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="deleted" column="deleted"/>
    </resultMap>

    <!--Create a review set-->
    <insert id="insert" parameterType="com.alibaba.cloud.ai.studio.admin.entity.DatasetDO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO dataset (name, description, columns_config, create_time, deleted)
        VALUES (#{name}, #{description}, #{columnsConfig}, NOW(), 0)
    </insert>

    <!--Delete a review set based on ID (logical deletion)-->
    <update id="deleteById" parameterType="long">
        UPDATE dataset SET deleted = 1 WHERE id = #{id}
    </update>

    <!--Get the evaluation set based on ID-->
    <select id="selectById" resultMap="datasetResultMap">
        SELECT <include refid="dataset_columns"/>
        FROM dataset
        WHERE id = #{id} AND deleted = 0
    </select>

    <!--Query the evaluation set list-->
    <select id="selectList" resultMap="datasetResultMap">
        SELECT
        <include refid="dataset_columns"/>
        FROM dataset
        <where>
            deleted = 0
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
        </where>
        ORDER BY create_time DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!--Query the total number of evaluation sets-->
    <select id="selectCount" resultType="int">
        SELECT COUNT(*)
        FROM dataset
        <where>
            deleted = 0
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
        </where>
    </select>

    <!--Update review set-->
    <update id="update" parameterType="com.alibaba.cloud.ai.studio.admin.entity.DatasetDO">
        UPDATE dataset
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="description != null">description = #{description},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id} AND deleted = 0
    </update>

</mapper>
