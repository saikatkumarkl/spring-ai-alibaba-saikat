# Simplified Dockerfile using pre-built JAR
# Build the JAR first using: mvn clean package -DskipTests
FROM eclipse-temurin:17-jre

WORKDIR /app

# Install wget (health check) and gosu (drop privileges)
RUN apt-get update && apt-get install -y wget gosu && rm -rf /var/lib/apt/lists/*

# Create a non-root user
RUN groupadd -r spring && useradd -r -g spring spring

# Copy the pre-built JAR file
COPY spring-ai-alibaba-admin-server-start/target/spring-ai-alibaba-admin-server-start.jar app.jar

# Create log + storage directories and change ownership
RUN mkdir -p /home/spring/logs /home/spring/cordondata/storage \
             /home/spring/APP_NAME_IS_UNDEFINED/logs/trace && \
    chown -R spring:spring /home/spring && \
    chown spring:spring app.jar && \
    chmod 1777 /tmp

# Copy entrypoint script
COPY docker/middleware/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/actuator/health || exit 1

# Start as root — entrypoint fixes volume perms then drops to spring
ENTRYPOINT ["/entrypoint.sh"]
